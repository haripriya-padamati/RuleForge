source_filename = "tests/assertions_ok.rf"

; Role IDs:
;   0 = Employee
;   1 = Manager
;   2 = Intern
; Resource IDs:
;   0 = Salary_Records
;   1 = Salary_History
;   2 = Public_Notice
; Action IDs:
;   0 = read
;   1 = write

; decision = { allowed bit, ID of the deciding rule }
%Decision = type { i1, i32 }

; Decision table from Step 6. Deny overrides allow; no rule = { false, 0 }.
; index = (role * 3 + resource) * 2 + action
@decision_table = internal constant [18 x %Decision] [
  %Decision { i1 false, i32 0 }, ; [0] Employee, Salary_Records, read
  %Decision { i1 false, i32 0 }, ; [1] Employee, Salary_Records, write
  %Decision { i1 false, i32 0 }, ; [2] Employee, Salary_History, read
  %Decision { i1 false, i32 0 }, ; [3] Employee, Salary_History, write
  %Decision { i1 true, i32 1 }, ; [4] Employee, Public_Notice, read
  %Decision { i1 false, i32 0 }, ; [5] Employee, Public_Notice, write
  %Decision { i1 true, i32 2 }, ; [6] Manager, Salary_Records, read
  %Decision { i1 false, i32 0 }, ; [7] Manager, Salary_Records, write
  %Decision { i1 true, i32 2 }, ; [8] Manager, Salary_History, read
  %Decision { i1 false, i32 0 }, ; [9] Manager, Salary_History, write
  %Decision { i1 true, i32 1 }, ; [10] Manager, Public_Notice, read
  %Decision { i1 false, i32 0 }, ; [11] Manager, Public_Notice, write
  %Decision { i1 false, i32 3 }, ; [12] Intern, Salary_Records, read
  %Decision { i1 false, i32 0 }, ; [13] Intern, Salary_Records, write
  %Decision { i1 false, i32 3 }, ; [14] Intern, Salary_History, read
  %Decision { i1 false, i32 0 }, ; [15] Intern, Salary_History, write
  %Decision { i1 true, i32 1 }, ; [16] Intern, Public_Notice, read
  %Decision { i1 false, i32 0 }  ; [17] Intern, Public_Notice, write
]

; Returns { allowed, rule_id } for one request.
; Any ID outside the declared range gets { false, 0 } (default deny).
define %Decision @checkAccess(i32 %role, i32 %res, i32 %act) {
entry:
  ; unsigned compare, so negative IDs are also out of range
  %role.ok = icmp ult i32 %role, 3
  %res.ok = icmp ult i32 %res, 3
  %act.ok = icmp ult i32 %act, 2
  %ok.1 = and i1 %role.ok, %res.ok
  %in.range = and i1 %ok.1, %act.ok
  br i1 %in.range, label %lookup, label %out.of.range

out.of.range:
  ret %Decision { i1 false, i32 0 }

lookup:
  ; index = (role * 3 + res) * 2 + act
  %t.1 = mul i32 %role, 3
  %t.2 = add i32 %t.1, %res
  %t.3 = mul i32 %t.2, 2
  %index = add i32 %t.3, %act
  %index.64 = zext i32 %index to i64
  %entry.ptr = getelementptr inbounds [18 x %Decision], ptr @decision_table, i64 0, i64 %index.64
  %decision = load %Decision, ptr %entry.ptr
  ret %Decision %decision
}

; Same answer packed into one i32 for C callers:
;   allowed = result & 1,  rule_id = result >> 1
define i32 @checkAccessPacked(i32 %role, i32 %res, i32 %act) {
entry:
  %d = call %Decision @checkAccess(i32 %role, i32 %res, i32 %act)
  %allowed = extractvalue %Decision %d, 0
  %rule.id = extractvalue %Decision %d, 1
  %allowed.32 = zext i1 %allowed to i32
  %rule.shifted = shl i32 %rule.id, 1
  %packed = or i32 %rule.shifted, %allowed.32
  ret i32 %packed
}
